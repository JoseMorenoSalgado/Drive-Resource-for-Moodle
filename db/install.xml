<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/videoplayer/db" VERSION="20261002" COMMENT="XMLDB file for Moodle mod_videoplayer"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="videoplayer" COMMENT="Stores Elearning Stream activity instances.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="source" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="bunnystream"/>
        <FIELD NAME="providerassetid" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="provideruploadid" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="providerfilesize" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="providerstatus" TYPE="char" LENGTH="32" NOTNULL="false"/>
        <FIELD NAME="disablecontextmenu" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="enablewatermark" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completionpercentage" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="80"/>
        <FIELD NAME="completionprogressenabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_idx" UNIQUE="false" FIELDS="course"/>
        <INDEX NAME="source_idx" UNIQUE="false" FIELDS="source"/>
        <INDEX NAME="providerasset_idx" UNIQUE="false" FIELDS="providerassetid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="videoplayer_views" COMMENT="Tracks Elearning Stream progress and completion per user.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="videoplayerid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="progress" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" DECIMALS="2"/>
        <FIELD NAME="completed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completionpercentage" TYPE="number" LENGTH="5" NOTNULL="true" DEFAULT="0" DECIMALS="2"/>
        <FIELD NAME="lastpage" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="totalpages" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timespent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lastposition" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"/>
        <FIELD NAME="duration" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"/>
        <FIELD NAME="watchedranges" TYPE="text" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_videoplayerid" TYPE="foreign" FIELDS="videoplayerid" REFTABLE="videoplayer" REFFIELDS="id"/>
        <KEY NAME="fk_userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="uniq_videoplayer_user" TYPE="unique" FIELDS="videoplayerid, userid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="completed_idx" UNIQUE="false" FIELDS="completed"/>
        <INDEX NAME="timemodified_idx" UNIQUE="false" FIELDS="timemodified"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="videoplayer_transfer_events" COMMENT="Queues Elearning Stream transfer bytes for batched gateway reporting.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="serviceid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="videoid" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="bytes" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="periodkey" TYPE="char" LENGTH="7" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="service_period_idx" UNIQUE="false" FIELDS="serviceid, periodkey"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
