{{!
    This file is part of Moodle - http://moodle.org/

    @template mod_videoplayer/video

    Protected HTML5 video viewer with precise playback progress state.
    Example context (json):
    {
        "type": "video",
        "cmid": 42,
        "trackingcmid": 42,
        "resourcetype": "Resource type: Video",
        "videourl": "https://example.invalid/protected.php?id=42",
        "videomimetype": "video/mp4",
        "title": "Protected video",
        "disablecontextmenu": true,
        "lastsecond": 15.5,
        "totalseconds": 120,
        "initialtimespent": 20,
        "watchedranges": "[[0,15.5]]",
        "completionpercent": 12.92,
        "completed": false
    }

}}
<div class="mod-videoplayer-container mod-videoplayer-native" data-resource-type="{{type}}" data-cmid="{{cmid}}"{{#playerstyle}} style="{{playerstyle}}"{{/playerstyle}}>
    <div class="mod-videoplayer-meta mb-2">
        {{#showresourcetype}}
            <span class="mod-videoplayer-meta-item">{{resourcetype}}</span>
        {{/showresourcetype}}
        <span class="mod-videoplayer-meta-item">{{#str}} protectedresource, mod_videoplayer {{/str}}</span>
        {{#completionpercent}}
            <span class="mod-videoplayer-meta-item" data-region="video-progress">{{completionpercent}}%</span>
        {{/completionpercent}}
    </div>

    <div class="mod-videoplayer-native-frame" {{#disablecontextmenu}}oncontextmenu="return false;"{{/disablecontextmenu}}>
        <video
            class="mod-videoplayer-native-video js-drive-resource-video"
            controls
            draggable="false"
            {{#disablecontextmenu}}oncontextmenu="return false;"{{/disablecontextmenu}}
            playsinline
            preload="metadata"
            data-cmid="{{trackingcmid}}"
            data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}"
            data-initial-second="{{lastsecond}}"
            data-total-seconds="{{totalseconds}}"
            data-initial-time-spent="{{initialtimespent}}"
            data-watched-ranges="{{watchedranges}}"
            data-initial-completion="{{completionpercent}}"
            data-initial-completed="{{#completed}}1{{/completed}}{{^completed}}0{{/completed}}"
            title="{{title}}">
            <source src="{{videourl}}"{{#videomimetype}} type="{{videomimetype}}"{{/videomimetype}}>
            {{#str}} videonotsupported, mod_videoplayer {{/str}}
        </video>

        <div
            class="mod-videoplayer-video-health"
            data-region="video-health"
            data-message-codec="{{#str}} videocodecunsupported, mod_videoplayer {{/str}}"
            data-message-generic="{{#str}} videogenericerror, mod_videoplayer {{/str}}"
            data-message-network="{{#str}} videonetworkerror, mod_videoplayer {{/str}}"
            data-message-unavailable="{{#str}} videoprotectedunavailable, mod_videoplayer {{/str}}"
            role="status"
            aria-live="polite"
            hidden>
            <div class="mod-videoplayer-video-health-card">
                <div class="mod-videoplayer-video-health-icon" aria-hidden="true">!</div>
                <strong class="mod-videoplayer-video-health-title">{{#str}} videoplaybackproblem, mod_videoplayer {{/str}}</strong>
                <p class="mod-videoplayer-video-health-message" data-region="video-health-message"></p>
                <button type="button" class="btn btn-light mod-videoplayer-video-health-retry" data-action="retry-video">
                    {{#str}} videoretry, mod_videoplayer {{/str}}
                </button>
            </div>
        </div>
    </div>
</div>
