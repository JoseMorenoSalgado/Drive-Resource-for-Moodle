{{!
    Protected HTML5 audio player.
}}
{{!
    @template mod_videoplayer/audio

    Protected native HTML5 audio player.

    Example context (json):
    {
        "type": "audio",
        "cmid": 42,
        "playerstyle": "",        "initialposition": 0,
        "initialduration": 180,
        "initialtimespent": 0,
        "watchedranges": "[[0,12]]",
        "trackprogress": true,
        "disablecontextmenu": true,
        "audiourl": "/mod/videoplayer/protected.php?id=42",
        "enablewatermark": true,
        "watermark": "Student"
    }
}}
<div class="mod-videoplayer-container mod-videoplayer-audio" data-resource-type="{{type}}" data-cmid="{{cmid}}"{{#playerstyle}} style="{{playerstyle}}"{{/playerstyle}}>

    <div class="mod-videoplayer-audio-card js-native-audio"
         data-cmid="{{cmid}}"
         data-initial-position="{{initialposition}}"
         data-initial-duration="{{initialduration}}"
         data-initial-timespent="{{initialtimespent}}"
         data-watched-ranges="{{watchedranges}}"
         data-tracking-enabled="{{#trackprogress}}1{{/trackprogress}}{{^trackprogress}}0{{/trackprogress}}"
         data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}">
        <audio class="mod-videoplayer-native-audio js-drive-resource-audio"
               src="{{audiourl}}"
               controls
               preload="metadata">
            {{#str}} audionotsupported, mod_videoplayer {{/str}}
        </audio>
        {{#enablewatermark}}
            <div class="mod-videoplayer-audio-watermark" aria-hidden="true">{{watermark}}</div>
        {{/enablewatermark}}
    </div>
</div>
