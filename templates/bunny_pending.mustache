{{!
    @template mod_videoplayer/bunny_pending

    Elearning Stream upload-complete placeholder shown while secure learner
    playback is not yet enabled for the provider.

    Example context (json):
    {
        "cmid": 42,
        "resourcetype": "Video"
    }
}}
<div class="mod-videoplayer-container" data-resource-type="video" data-cmid="{{cmid}}">
    <div class="mod-videoplayer-meta mb-2">
        <span class="mod-videoplayer-meta-item">{{resourcetype}}</span>
        <span class="mod-videoplayer-meta-item">{{#str}} sourcebunnystream, mod_videoplayer {{/str}}</span>
    </div>
    <div class="alert alert-info" role="status">
        <strong>{{#str}} bunnyassetuploaded, mod_videoplayer {{/str}}</strong>
        <div>{{#str}} bunnyplaybackphasepending, mod_videoplayer {{/str}}</div>
    </div>
</div>
