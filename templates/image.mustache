{{!
    Protected image viewer.
}}
<div class="mod-videoplayer-container mod-videoplayer-image" data-resource-type="{{type}}" data-cmid="{{cmid}}" data-protected-ui data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}">
    <div class="mod-videoplayer-meta mb-2">
        {{#showresourcetype}}<span class="mod-videoplayer-meta-item">{{resourcetype}}</span>{{/showresourcetype}}
        <span class="mod-videoplayer-meta-item">{{#str}} protectedresource, mod_videoplayer {{/str}}</span>
    </div>

    <figure class="mod-videoplayer-image-frame"
            data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}">
        <img src="{{imageurl}}"
             class="mod-videoplayer-protected-image"
             alt="{{title}}"
             loading="eager"
             decoding="async"
             draggable="false">
        {{#enablewatermark}}
            <figcaption class="mod-videoplayer-image-watermark" aria-hidden="true">{{watermark}}</figcaption>
        {{/enablewatermark}}
    </figure>
</div>
