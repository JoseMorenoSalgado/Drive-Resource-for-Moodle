{{!
    @template mod_videoplayer/pdfjs

    Stable protected PDF.js viewer.

    Example context (json):
    {
        "type": "pdf",
        "cmid": 42,
        "resourcetype": "Resource type: PDF",
        "completionpercent": 25,
        "initialpage": 1,
        "totalpages": 10,
        "points": 5,
        "pdfurl": "https://example.com/protected.php?id=42",
        "title": "Example protected PDF",
        "displaymode": "pdfjs",
        "disablecontextmenu": true,
        "enablewatermark": true,
        "enablegamification": true,
        "watermark": "Example learner"
    }
}}
<div class="mod-videoplayer-container mod-videoplayer-pdfjs"
     data-resource-type="{{type}}"
     data-cmid="{{trackingcmid}}">
    <div class="mod-videoplayer-meta mb-2">
        <span class="mod-videoplayer-meta-item">{{resourcetype}}</span>
        <span class="mod-videoplayer-meta-item">{{#str}} protectedresource, mod_videoplayer {{/str}}</span>
        {{#completionpercent}}
            <span class="mod-videoplayer-meta-item" data-region="pdfjs-progress">{{completionpercent}}%</span>
        {{/completionpercent}}
        {{#enablegamification}}
            <span class="mod-videoplayer-meta-item">
                {{#str}} points, mod_videoplayer {{/str}}:
                <strong data-region="pdfjs-points">{{points}}</strong>
            </span>
        {{/enablegamification}}
    </div>

    <div class="mod-videoplayer-pdfjs-viewer"
         data-pdf-url="{{pdfurl}}"
         data-title="{{title}}"
         data-cmid="{{cmid}}"
         data-initial-page="{{initialpage}}"
         data-display-mode="pdfjs"
         data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}"
         data-watermark="{{#enablewatermark}}{{watermark}}{{/enablewatermark}}"
         oncontextmenu="return false;">
        <div class="mod-videoplayer-pdfjs-overlay" aria-label="{{title}}">
            <button type="button"
                    class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-prev"
                    data-action="previous-page"
                    title="{{#str}} previouspage, mod_videoplayer {{/str}}"
                    aria-label="{{#str}} previouspage, mod_videoplayer {{/str}}">
                <span aria-hidden="true">‹</span>
            </button>

            <button type="button"
                    class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-zoomout"
                    data-action="zoom-out"
                    title="{{#str}} zoomout, mod_videoplayer {{/str}}"
                    aria-label="{{#str}} zoomout, mod_videoplayer {{/str}}">
                <span aria-hidden="true">−</span>
            </button>

            <span class="mod-videoplayer-pdfjs-page-status" aria-live="polite">
                <span data-region="current-page">1</span> /
                <span data-region="total-pages">-</span>
                <span class="mod-videoplayer-pdfjs-zoom-status" data-region="zoom-level">100%</span>
            </span>

            <button type="button"
                    class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-zoomin"
                    data-action="zoom-in"
                    title="{{#str}} zoomin, mod_videoplayer {{/str}}"
                    aria-label="{{#str}} zoomin, mod_videoplayer {{/str}}">
                <span aria-hidden="true">+</span>
            </button>

            <button type="button"
                    class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-fit"
                    data-action="fit-screen"
                    title="{{#str}} fittoscreen, mod_videoplayer {{/str}}"
                    aria-label="{{#str}} fittoscreen, mod_videoplayer {{/str}}">
                <span aria-hidden="true">⤢</span>
            </button>

            <button type="button"
                    class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-fullscreen"
                    data-action="fullscreen"
                    title="{{#str}} fullscreen, mod_videoplayer {{/str}}"
                    aria-label="{{#str}} fullscreen, mod_videoplayer {{/str}}">
                <span aria-hidden="true">⛶</span>
            </button>

            <button type="button"
                    class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-next"
                    data-action="next-page"
                    title="{{#str}} nextpage, mod_videoplayer {{/str}}"
                    aria-label="{{#str}} nextpage, mod_videoplayer {{/str}}">
                <span aria-hidden="true">›</span>
            </button>
        </div>

        <div class="mod-videoplayer-pdfjs-canvas-wrap" oncontextmenu="return false;">
            <div class="mod-videoplayer-pdfjs-loading" data-region="pdfjs-loading">
                <span class="mod-videoplayer-pdfjs-spinner" aria-hidden="true"></span>
                <span>{{#str}} loadingpdf, mod_videoplayer {{/str}}</span>
            </div>

            <div class="mod-videoplayer-pdfjs-canvas-stage" data-region="pdfjs-stage">
                <canvas class="mod-videoplayer-pdfjs-canvas"
                        draggable="false"
                        oncontextmenu="return false;"></canvas>
                {{#enablewatermark}}
                    <div class="mod-videoplayer-watermark" aria-hidden="true">{{watermark}}</div>
                {{/enablewatermark}}
            </div>
        </div>

        {{#enablegamification}}
            <div class="mod-videoplayer-achievements"
                 data-region="pdfjs-achievements"
                 aria-live="polite"></div>
        {{/enablegamification}}

        <div class="mod-videoplayer-pdfjs-error alert alert-danger"
             data-region="pdfjs-error"
             hidden>
            {{#str}} pdfjsrequired, mod_videoplayer {{/str}}
        </div>
    </div>
</div>
