{{!
    Local PDF.js viewer for PDF, Google Docs, Sheets and Slides exports.
}}
{{!
    @template mod_videoplayer/pdfjs

    Local PDF.js protected document viewer.

    Example context (json):
    {
        "type": "pdf",
        "cmid": 42,
        "showresourcetype": true,
        "resourcetype": "PDF",
        "completionpercent": 40,
        "enablegamification": true,
        "points": 10,
        "totalpages": 12,
        "initialpage": 3,
        "pdfurl": "/mod/videoplayer/protected.php?id=42",
        "title": "Protected PDF",
        "initialtimespent": 120,
        "trackprogress": true,
        "disablecontextmenu": true,
        "enablewatermark": true,
        "watermark": "Student"
    }
}}
<div class="mod-videoplayer-container mod-videoplayer-pdfjs" data-resource-type="{{type}}" data-cmid="{{cmid}}">
    <div class="mod-videoplayer-meta mb-2">
        {{#showresourcetype}}<span class="mod-videoplayer-meta-item">{{resourcetype}}</span>{{/showresourcetype}}
        <span class="mod-videoplayer-meta-item">{{#str}} protectedresource, mod_videoplayer {{/str}}</span>
        <span class="mod-videoplayer-meta-item" data-region="pdfjs-progress">{{completionpercent}}%</span>
        {{#enablegamification}}
            <span class="mod-videoplayer-meta-item" data-region="pdfjs-points">{{points}} {{#str}} points, mod_videoplayer {{/str}}</span>
        {{/enablegamification}}
    </div>

    <div data-region="pdfjs-achievements" aria-live="polite"></div>

    <div class="mod-videoplayer-resume alert alert-info" data-region="pdfjs-resume" {{^totalpages}}hidden{{/totalpages}}>
        {{#str}} resumereading, mod_videoplayer {{/str}}
        <strong>{{initialpage}}</strong>{{#totalpages}} / {{totalpages}}{{/totalpages}}
    </div>

    <div class="mod-videoplayer-pdfjs-viewer"
         data-pdf-url="{{pdfurl}}"
         data-title="{{title}}"
         data-cmid="{{cmid}}"
         data-initial-page="{{initialpage}}"
         data-initial-timespent="{{initialtimespent}}"
         data-tracking-enabled="{{#trackprogress}}1{{/trackprogress}}{{^trackprogress}}0{{/trackprogress}}"
         data-points-label="{{#str}} points, mod_videoplayer {{/str}}"
         data-searching-text="{{#str}} searching, mod_videoplayer {{/str}}"
         data-no-matches-text="{{#str}} nomatches, mod_videoplayer {{/str}}"
         data-display-mode="standard"
         data-disable-context-menu="{{#disablecontextmenu}}1{{/disablecontextmenu}}{{^disablecontextmenu}}0{{/disablecontextmenu}}"
         data-watermark="{{#enablewatermark}}{{watermark}}{{/enablewatermark}}">
        <div class="mod-videoplayer-pdfjs-search" data-region="pdfjs-search">
            <label class="sr-only" for="pdf-search-{{cmid}}">{{#str}} searchpdf, mod_videoplayer {{/str}}</label>
            <input id="pdf-search-{{cmid}}" type="search" class="form-control form-control-sm" data-region="pdfjs-search-input" placeholder="{{#str}} searchpdf, mod_videoplayer {{/str}}">
            <button type="button" class="btn btn-secondary btn-sm" data-action="search-pdf">{{#str}} search, core {{/str}}</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="search-next" disabled>{{#str}} nextmatch, mod_videoplayer {{/str}}</button>
            <span class="mod-videoplayer-pdfjs-search-status" data-region="pdfjs-search-status" aria-live="polite"></span>
        </div>

        <div class="mod-videoplayer-pdfjs-canvas-wrap">
            <div class="mod-videoplayer-pdfjs-loading" data-region="pdfjs-loading">
                <span class="mod-videoplayer-pdfjs-spinner" aria-hidden="true"></span>
                <span>{{#str}} loadingpdf, mod_videoplayer {{/str}}</span>
            </div>

            <div class="mod-videoplayer-pdfjs-overlay" role="group" aria-label="{{title}}">
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-prev" data-action="previous-page" title="{{#str}} previouspage, mod_videoplayer {{/str}}" aria-label="{{#str}} previouspage, mod_videoplayer {{/str}}"><span aria-hidden="true">‹</span></button>
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-zoomout" data-action="zoom-out" title="{{#str}} zoomout, mod_videoplayer {{/str}}" aria-label="{{#str}} zoomout, mod_videoplayer {{/str}}"><span aria-hidden="true">−</span></button>
                <span class="mod-videoplayer-pdfjs-page-status" aria-live="polite">
                    <span data-region="current-page">1</span> / <span data-region="total-pages">-</span>
                    <span class="mod-videoplayer-pdfjs-zoom-status" data-region="zoom-level">100%</span>
                </span>
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-zoomin" data-action="zoom-in" title="{{#str}} zoomin, mod_videoplayer {{/str}}" aria-label="{{#str}} zoomin, mod_videoplayer {{/str}}"><span aria-hidden="true">+</span></button>
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-fit" data-action="fit-screen" title="{{#str}} fitscreen, mod_videoplayer {{/str}}" aria-label="{{#str}} fitscreen, mod_videoplayer {{/str}}"><span aria-hidden="true">⤢</span></button>
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-fullscreen" data-action="fullscreen" title="{{#str}} fullscreen, mod_videoplayer {{/str}}" aria-label="{{#str}} fullscreen, mod_videoplayer {{/str}}"><span aria-hidden="true">⛶</span></button>
                <button type="button" class="mod-videoplayer-pdfjs-control mod-videoplayer-pdfjs-control-next" data-action="next-page" title="{{#str}} nextpage, mod_videoplayer {{/str}}" aria-label="{{#str}} nextpage, mod_videoplayer {{/str}}"><span aria-hidden="true">›</span></button>
            </div>

            <canvas class="mod-videoplayer-pdfjs-canvas" draggable="false"></canvas>
            {{#enablewatermark}}
                <div class="mod-videoplayer-watermark" aria-hidden="true">{{watermark}}</div>
            {{/enablewatermark}}
        </div>

        <div class="mod-videoplayer-pdfjs-error alert alert-danger" data-region="pdfjs-error" hidden>{{#str}} pdfjsrequired, mod_videoplayer {{/str}}</div>
    </div>
</div>
